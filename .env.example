# Backend
API_PORT=8000
HOST=0.0.0.0

# Frontend
# Leave unset: the Next.js app serves the API itself at /api/v1. Set only to use the Python API instead,
# e.g. NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=
# Optional: Google Map Tiles API key for satellite imagery (falls back to Esri when unset).
# Put it in apps/web/.env.local (gitignored). This key ships to the browser, so restrict it
# to the Map Tiles API and your site's HTTP referrers in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Data Downloaders (Copernicus CDS)
# DO NOT add real CDS credentials here. Place them in ~/.cdsapirc
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=YOUR_API_KEY
